model User {
  id        String    @id @default(uuid()) @map("_id")
  firstName String
  lastName  String
  email     String    @unique
  password  String
  role      UserRole? @default(CUSTOMER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  SUPERADMIN
  ADMIN
  CUSTOMER
}
